# TinAiLens API (server-only)

PORT=3001
NODE_ENV=development

# CORS — comma-separated origins, or * for local extension testing
CORS_ORIGIN=*

# Rate limit (analyze)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# AI (see packages/ai/.env.example)
AI_PROVIDER=openai
AI_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_MARKDOWN_CHARS=24000
AI_MIN_MARKDOWN_CHARS=120

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
