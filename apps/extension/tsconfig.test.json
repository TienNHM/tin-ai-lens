{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist-test",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "declaration": false
  },
  "include": ["lib/markdown.ts", "lib/markdown.test.ts"],
  "exclude": ["node_modules", "build", ".plasmo", "dist-test"]
}
