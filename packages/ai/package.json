{
  "name": "@tin-ai-lens/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-agnostic AI analysis for TinAiLens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/policy/banned-phrases.test.js dist-test/grounding/snippets.test.js dist-test/truncate.test.js",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist dist-test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tin-ai-lens/types": "workspace:*",
    "ai": "^7.0.47",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@tin-ai-lens/config": "workspace:*",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
